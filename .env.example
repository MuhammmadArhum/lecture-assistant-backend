# Rename to .env and fill in before running.

# LLM provider (used by the Synthesis, Refinement, and Final Brief nodes)
GROQ_API_KEY=your-groq-key-here
LLM_MODEL=llama-3.3-70b-versatile

# Web search provider (used by the Search Node)
TAVILY_API_KEY=your-tavily-key-here

# Deterministic seed applied to every model call, per assignment requirement
GRAPH_SEED=20260812
